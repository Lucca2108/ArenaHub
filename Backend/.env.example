# Mude para "production" quando for subir para produção
ENVIRONMENT=development

# URL do NeonDB/Postgres (usado em produção)
DATABASE_URL=postgresql://usuario:SUA_SENHA_AQUI@host.neon.tech/neondb?sslmode=require

# Chave usada para assinar os tokens JWT. Gere uma chave longa para cada ambiente.
SECRET_KEY=troque-por-uma-chave-secreta-longa
ACCESS_TOKEN_EXPIRE_MINUTES=60
